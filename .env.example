# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection (Supabase PostgreSQL / Direct PostgreSQL)
# For Supabase Session mode / Transaction pooler:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# For Supabase Direct connection / migrations:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication Secret (for secure session tokens)
AUTH_SECRET="vyparx-ultra-secure-jwt-secret-key-production-ready-32chars"

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=notifications@vyparx.com

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Central Support Contact
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+919876543210"
NEXT_PUBLIC_SUPPORT_EMAIL="support@vyparx.com"
